# ====================================================================
# LagerLurch – Umgebungsvariablen (Beispiel für GitHub / Deployment)
# ====================================================================
# Kopiere diese Datei nach .env und trage deine echten Supabase-Zugangsdaten ein.
#
# So findest du deine Daten im Supabase Dashboard:
# 1. Öffne dein Supabase-Projekt
# 2. Gehe zu: Project Settings -> Database
# 3. Scrolle zu "Connection string" -> Tab "URI"
# --------------------------------------------------------------------

# Verbindung zur Supabase PostgreSQL-Datenbank (Connection Pooling empfohlen)
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direkte Verbindung (für Migrationen / Direct Connection auf Port 5432)
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Optional: Supabase API Keys (falls du später Supabase Auth oder Storage verwendest)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# --------------------------------------------------------------------
# E-Mail / SMTP-Konfiguration (Version B: Direkter Serverversand)
# --------------------------------------------------------------------
# Für Microsoft 365 / Outlook:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="deine-adresse@deine-firma.de"
# SMTP_PASS="dein-app-passwort"
# SMTP_FROM="LagerLurch <deine-adresse@deine-firma.de>"
# DEFAULT_ORDER_EMAIL="einkauf@deine-firma.de"
#
# Für andere Anbieter (z.B. Strato, IONOS, Web.de, Gmail):
# SMTP_HOST="smtp.strato.de"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="lager@deine-domain.de"
# SMTP_PASS="passwort"

